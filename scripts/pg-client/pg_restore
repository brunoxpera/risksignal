#!/bin/sh
# pg_restore shim for `make backup` / `make restore-test` (WP-6.09 / DEV-122).
#
# See scripts/pg-client/pg_dump for the rationale: the restore runs the client
# inside the compose `db` service so its major version matches the postgres:16
# server. Stdin is forwarded (-T), so a dump read from stdin restores cleanly.
set -eu
root=$(cd "$(dirname "$0")/../.." && pwd)
exec docker compose -f "$root/compose.yaml" exec -T -e PGPASSWORD -e PGSSLMODE db pg_restore "$@"

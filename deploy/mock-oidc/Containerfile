# syntax=docker/dockerfile:1

# RiskSignal mock OIDC provider — development image (WP-1a.03, D-003).
# Multi-stage: Go 1.27 build (ADR-008, tag carries the major/minor) on
# golang:1.27, minimal Alpine runtime (busybox wget backs the compose
# healthcheck). Dev/test tool; hardened production image is WP-1a.13.

FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mock-oidc ./cmd/mock-oidc

FROM alpine:3.24.1
RUN apk add --no-cache ca-certificates
COPY --from=build /out/mock-oidc /usr/local/bin/mock-oidc
EXPOSE 9000
ENTRYPOINT ["mock-oidc"]

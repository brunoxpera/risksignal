# RiskSignal — private demo deployment environment (ARCH-007 §8, DEV-131).
#
# Copy this file to deploy/demo/.env (git-ignored) and replace the
# placeholders before the first
#   docker compose -f deploy/demo/compose.yaml up -d --build
#
# No real secret belongs in the repository: the values below that look like
# credentials are dev-only placeholders for the private demo. The compose
# stack injects every secret through the environment at runtime.

# The public demo hostname Caddy serves and terminates TLS for. Use
# "localhost" for a local trial (Caddy's internal CA); a real hostname gets an
# ACME certificate.
DEMO_DOMAIN=localhost

# Contact address for the ACME account when DEMO_DOMAIN is a public hostname
# (see the Caddyfile if you need to enable it).
# ACME_EMAIL=ops@example.com

# OIDC issuer (mandatory in demo mode). Point at the private demo's identity
# provider; roles are mapped from the configured claim.
DEMO_OIDC_ISSUER=https://id.demo.example/realms/risksignal
DEMO_OIDC_CLIENT_ID=risksignal-demo
# The client secret is runtime-injected. Leave empty here; the compose stack
# reads it from this variable (oidc.client_secret_ref names it, presence-only).
DEMO_OIDC_CLIENT_SECRET=

# Database passwords. Dev-only placeholders — the secret store supplies these
# in a real deployment. The retention password provisions the migration-created
# risksignal_retention_login (DEV-129).
DEMO_DB_PASSWORD=risksignal
DEMO_RETENTION_PASSWORD=risksignal_retention

# The age backup identity (AGE-SECRET-KEY-1…). Generate one with `age-keygen`
# and keep it off-host with the same care as the data it protects; the backup
# service names it through backup.encryption_key_ref
# (RISKSIGNAL_BACKUP_ENCRYPTION_KEY_REF=RISKSIGNAL_BACKUP_AGE_IDENTITY).
# Never commit a real identity.
RISKSIGNAL_BACKUP_AGE_IDENTITY=

# syntax=docker/dockerfile:1

# RiskSignal server — production container image (WP-1a.13; implementation
# concept ch. 4.4 deployment step 1, ch. 18.2 deliverable).
#
# Multi-stage and non-root:
#   build   golang:1.27 — ADR-008 pins the toolchain as "1.27" in go.mod,
#           containerfile and CI alike; the patch level is a build-time
#           detail and is captured per build by the module SBOM (make sbom).
#   runtime gcr.io/distroless/static-debian12:nonroot pinned by digest
#           (multi-arch index digest, resolved 2026-09-09, DEV-014) — no
#           shell, no package manager, uid 65532.
#
# The WP-1a.07 build metadata (version, git commit, build time) is injected
# through the same -ldflags -X variables that `make build` uses. The values
# arrive as build args — `make image` passes them — so GET /version inside
# the container reports the release that was built. CA certificates are
# copied from the build stage (the static distroless image ships none) so
# TLS to PostgreSQL and the OIDC issuer works later.
#
# Build with `make image`; the CI image job (WP-1a.13) builds the same way.

FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w \
        -X github.com/brunoxpera/risksignal/internal/platform/buildinfo.Version=${VERSION} \
        -X github.com/brunoxpera/risksignal/internal/platform/buildinfo.Commit=${GIT_COMMIT} \
        -X github.com/brunoxpera/risksignal/internal/platform/buildinfo.BuildTime=${BUILD_TIME}" \
    -o /out/risksignal-server ./cmd/risksignal-server

# The export spool root (export.dir, default var/exports). Copying it into the
# runtime image owned by the non-root user (65532) makes export.dir writable
# out of the box and, because Docker seeds a fresh named volume from the
# image path, lets the demo overlay mount a writable volume over it (DEV-136,
# ARCH-007 §1.2/§8).
RUN mkdir -p /out/exports

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# Redeclared so the OCI labels below see the values passed with --build-arg.
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="risksignal-server" \
      org.opencontainers.image.description="RiskSignal server: REST API, web UI and system endpoints" \
      org.opencontainers.image.source="https://github.com/brunoxpera/risksignal" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/risksignal-server /usr/local/bin/risksignal-server
# The export spool root, owned by the non-root runtime user (see the build
# stage): a named volume mounted here inherits 65532:65532 and stays writable
# (DEV-136).
COPY --from=build --chown=65532:65532 /out/exports /var/exports
ENTRYPOINT ["/usr/local/bin/risksignal-server"]
